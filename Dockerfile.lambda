FROM public.ecr.aws/lambda/nodejs:20

# DocumentDB TLS CA bundle (the handler's mongoose connect uses MONGODB_TLS_CA_FILE)
RUN dnf install -y unzip tar gzip ca-certificates findutils \
 && curl -fsSL -o /etc/ssl/certs/global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
 && dnf clean all
ENV MONGODB_TLS_CA_FILE=/etc/ssl/certs/global-bundle.pem

# esbuild bundles every dep we need into one CJS file, so node_modules is unnecessary.
COPY dist/handler.cjs ${LAMBDA_TASK_ROOT}/handler.cjs

CMD ["handler.handler"]
