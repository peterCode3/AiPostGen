{
  "scripts": {
    "dev": "concurrently \"next dev\" \"npm run worker:dev --once\"",
    "worker:dev": "concurrently \"tsx workers/scrape.ts\" \"tsx workers/generate.ts\"",
    "build": "next build && tsc -p tsconfig.json --noEmit",
    "build:lambda": "esbuild src/lambda/handler.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/handler.cjs --external:@aws-sdk/*",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf .next",
    "type": "module"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/typography": "^0.5.19",
    "@types/aws-lambda": "^8.10.145",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.6.0",
    "@types/react": "19.1.16",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.24.0",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "cheerio": "^1.1.2",
    "cloudinary": "^2.7.0",
    "concurrently": "^9.2.1",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.3",
    "formidable": "^3.5.4",
    "framer-motion": "^12.23.22",
    "got": "^14.4.9",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.544.0",
    "marked": "^16.4.0",
    "mysql2": "^3.23.2",
    "next": "^15.5.4",
    "p-limit": "^5.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "remark-gfm": "^4.0.1",
    "scrapegraph-js": "^0.1.7",
    "tsx": "^4.20.6",
    "zod": "^3.25.76",
    "@google-cloud/pubsub": "^4.9.0",
    "@google-cloud/storage": "^7.14.0",
    "google-auth-library": "^9.15.0"
  }
