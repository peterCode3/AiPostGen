# Cloud Run image for aipostgen-worker (replaces the SQS-triggered Lambda image).
#
# Bundles src/cloudrun/worker.ts with esbuild — same approach as the Lambda's
# build:lambda step — then runs it as a plain Node HTTP server so Pub/Sub can
# push to it. No AWS Lambda runtime interface, no RDS CA bundle.

FROM node:20-alpine AS build
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
# Bundle the worker entrypoint. Native/optional deps stay external so esbuild
# does not try to inline binaries.
RUN npx esbuild src/cloudrun/worker.ts \
      --bundle --platform=node --target=node20 --format=cjs \
      --outfile=dist/worker.cjs \
      --external:mysql2 \
      --external:@google-cloud/* \
      --external:cheerio \
      --external:got \
      --external:@anthropic-ai/sdk

FROM node:20-alpine AS prune
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
RUN apk add --no-cache libc6-compat ca-certificates
COPY --from=prune /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./package.json

EXPOSE 8080
CMD ["node", "dist/worker.cjs"]
